// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum GenerationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 UserRole  @default(STUDENT)
  
  // Organization & Permissions
  organizationId       String?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isSubAdmin          Boolean       @default(false)

  // Security
  failedLoginAttempts Int        @default(0)
  lockedUntil       DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdTests       Test[]    @relation("CreatedTests")
  submissions      Submission[]
  
  // Student Groups
  studentGroups     StudentGroupMember[]
  createdGroups     StudentGroup[] @relation("CreatedGroups")

  // Documents & AI Generation
  documents          Document[]
  generationSessions GenerationSession[]
  documentConversations DocumentConversation[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
}

model StudentGroup {
  id        String   @id @default(cuid())
  name      String
  creatorId String
  creator   User     @relation("CreatedGroups", fields: [creatorId], references: [id], onDelete: Cascade)
  members   StudentGroupMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  group     StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([groupId, studentId])
}

model Test {
  id          String    @id @default(cuid())
  title       String
  description String?
  duration    Int       // Duration in minutes
  published   Boolean   @default(false)
  archived      Boolean   @default(false)
  visibility    TestVisibility @default(ORGANIZATION)
  targetRole    TargetRole     @default(STUDENT)
  bioDataFields Json?     // Stores the configuration of fields to collect
  creatorId     String
  creator     User      @relation("CreatedTests", fields: [creatorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions   Question[]
  submissions Submission[]
  allowedUsers TestAllowedUser[]
}

enum TestVisibility {
  PUBLIC
  ORGANIZATION
  WHITELIST
}

enum TargetRole {
  STUDENT
  TEACHER
  ALL
}

model TestAllowedUser {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([testId, email])
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model Question {
  id          String       @id @default(cuid())
  testId      String
  test        Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  text        String
  type        QuestionType
  points      Int          @default(1)
  options     Json?        // For MCQs: ["Option A", "Option B", ...]
  correctAnswer String     // Stored securely, maybe hashed if sensitive, but usually plain for checking
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  answers     Answer[]
}

model Submission {
  id          String    @id @default(cuid())
  testId      String
  test        Test      @relation(fields: [testId], references: [id])
  studentId   String?   // Optional for guest users
  student     User?     @relation(fields: [studentId], references: [id])
  guestInfo   Json?     // Stores name/email for guest users
  startTime   DateTime  @default(now())
  endTime     DateTime?
  score       Int?
  graded      Boolean   @default(false)
  
  // Monitoring fields
  status          SubmissionStatus @default(STARTED)
  bioData         Json?            // Stores the actual data submitted by the student
  currentWarnings Int              @default(0)
  lastHeartbeat   DateTime         @default(now())

  answers     Answer[]
}
enum SubmissionStatus {
  STARTED
  COMPLETED
}

model Answer {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  value        String     // The student's answer
  isCorrect    Boolean?   // Null if not yet graded
}

// ─── AI-Powered Document & Question Generation ───

model Document {
  id           String         @id @default(cuid())
  filename     String         // UUID-based name in S3
  originalName String         // Original uploaded filename
  mimeType     String
  size         Int            // Bytes
  content      String?        // Full extracted text (for LLM-native queries)
  status       DocumentStatus @default(PROCESSING)
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  chunks       DocumentChunk[]
  generations  GenerationSession[]
  conversations DocumentConversation[]

  @@index([userId])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  index      Int      // Order within the document
  embedding  Unsupported("vector(1536)")?  // pgvector embedding

  @@index([documentId])
}

model DocumentConversation {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String   @default("New Conversation")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages DocumentMessage[]

  @@index([documentId])
  @@index([userId])
}

model DocumentMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   DocumentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  createdAt      DateTime             @default(now())

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
}

model GenerationSession {
  id              String           @id @default(cuid())
  documentId      String
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  questionType    QuestionType     @default(MULTIPLE_CHOICE)
  count           Int              @default(5)
  difficulty      String           @default("medium")
  prompt          String?          // Custom instructions from teacher
  status          GenerationStatus @default(PROCESSING)
  createdAt       DateTime         @default(now())
  completedAt     DateTime?

  questions       GeneratedQuestion[]

  @@index([documentId])
  @@index([userId])
}

model GeneratedQuestion {
  id            String           @id @default(cuid())
  sessionId     String
  session       GenerationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text          String
  type          QuestionType
  points        Int              @default(1)
  options       Json?            // For MCQ: ["Option A", "Option B", ...]
  correctAnswer String
  explanation   String?          // Why this is correct
  sourceChunks  Json?            // References to source chunk indices
  approved      Boolean?         // null=pending, true=approved, false=rejected
  feedback      String?          // Teacher feedback on generation

  @@index([sessionId])
}
