{
  "name": "testwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=4096 && next dev",
    "build": "set NODE_OPTIONS=--max-old-space-size=4096 && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed:prod": "ts-node --project prisma/tsconfig.seed.json prisma/seed-production.ts",
    "worker": "set NODE_OPTIONS=--max-old-space-size=16384 && tsx workers/document-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@langchain/core": "^1.1.46",
    "@langchain/openai": "^1.4.5",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.10.2",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.8",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.10.1",
    "langchain": "^1.4.0",
    "lucide-react": "^0.554.0",
    "mammoth": "^1.12.0",
    "next": "16.0.10",
    "next-auth": "^4.24.13",
    "openai": "^6.37.0",
    "pdf-parse": "^1.1.1",
    "pdf2json": "^4.0.3",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/busboy": "^1.5.4",
    "@types/exceljs": "^0.5.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.29",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "prisma": "^5.10.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
