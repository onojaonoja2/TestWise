# Database Connection
# Local:   postgresql://user:password@localhost:5432/testwise
# Railway: paste the service's PUBLIC url for local dev, or use ${{Postgres.DATABASE_URL}}
#          (private url) inside Railway services. Append ?sslmode=require for public URLs.
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Redis / BullMQ queue
# Local:   redis://localhost:6379 (see docker-compose.yml)
# Railway: worker uses the PRIVATE url (${{Redis.REDIS_URL}});
#          Vercel + local dev use the PUBLIC url from the Redis service.
REDIS_URL="redis://localhost:6379"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32-never-commit-the-real-value"

# Optional: Google OAuth (if enabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI / OpenRouter
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="openai/gpt-4o"

# S3 document storage
S3_BUCKET_NAME="testwise-documents"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-north-1"
# Optional public base URL for S3 objects (avatars, etc).
# Defaults to https://<bucket>.s3.<region>.amazonaws.com — set this if you use CloudFront.
S3_PUBLIC_URL=""

# Password reset email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="TestWise <noreply@example.com>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Background worker (workers/document-worker.ts)
# Lower concurrency on small Railway plans to reduce memory pressure.
WORKER_CONCURRENCY="4"
# Set NODE_OPTIONS per host to match available RAM, e.g.:
# NODE_OPTIONS="--max-old-space-size=4096"
